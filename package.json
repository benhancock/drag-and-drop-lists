{
  "name": "drag-and-drop-lists",
  "version": "1.0.0",
  "description": "Reorder list items by dragging their markers, with animated previews and mobile task status controls.",
  "private": true,
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "check": "npm test && npm run typecheck && npm run lint -- --max-warnings 0 && npm run build",
    "dev": "node esbuild.config.mjs",
    "generate:icons": "node scripts/generate-heroicons-micro.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "drag-and-drop",
    "lists",
    "tasks"
  ],
  "author": "Ben Hancock",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benhancock/drag-and-drop-lists.git"
  },
  "bugs": {
    "url": "https://github.com/benhancock/drag-and-drop-lists/issues"
  },
  "homepage": "https://github.com/benhancock/drag-and-drop-lists#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.15.17",
    "esbuild": "^0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.1",
    "heroicons": "^2.2.0",
    "jiti": "^2.6.1",
    "obsidian": "1.13.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.2.4"
  }
}
